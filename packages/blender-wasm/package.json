{
  "name": "@knervous/blender-wasm",
  "version": "0.1.0",
  "description": "Blender embedded as WebAssembly: ships the wasm runtime and a project API that keeps a Babylon.js or three.js scene in sync with a persistent in-tab Blender session.",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knervous/blender-wasm.git",
    "directory": "packages/blender-wasm"
  },
  "keywords": [
    "blender",
    "webassembly",
    "wasm",
    "babylonjs",
    "threejs",
    "gltf",
    "3d"
  ],
  "exports": {
    ".": {
      "types": "./dist/project/index.d.ts",
      "default": "./dist/project/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "default": "./dist/browser/index.js"
    },
    "./babylon": {
      "types": "./dist/babylon/index.d.ts",
      "default": "./dist/babylon/index.js"
    },
    "./three": {
      "types": "./dist/three/index.d.ts",
      "default": "./dist/three/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./vite": {
      "types": "./dist/runtime/vite.d.ts",
      "default": "./dist/runtime/vite.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./protocol.py": "./dist/project/protocol.py",
    "./package.json": "./package.json"
  },
  "bin": {
    "blender-wasm": "./dist/runtime/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "DESIGN.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/build.mjs --generate-only && tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@knervous/blender-wasm-runtime": "0.1.0",
    "@babylonjs/core": ">=8",
    "three": ">=0.160",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "@babylonjs/core": {
      "optional": true
    },
    "three": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babylonjs/core": "^9.31.0",
    "@knervous/blender-wasm-runtime": "file:../../dist/blender-wasm-browser",
    "@types/node": "^22.19.0",
    "@types/three": "^0.186.0",
    "three": "^0.186.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
