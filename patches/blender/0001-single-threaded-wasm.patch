+++ b/source/creator/creator.cc
@@ -119,6 +119,10 @@ extern "C" EMSCRIPTEN_KEEPALIVE int blender_web_mount_provider(int mountId, cons
 
 #include "WM_api.hh"
 
+#if defined(BLI_THREADS_INLINE) && defined(WITH_PYTHON)
+#  include "BPY_extern_run.hh"
+#endif
+
 #include "RNA_define.hh"
 
 #include "FN_init.hh"
@@ -810,6 +814,21 @@ int main(int argc,
     else {
       exit_code = G.is_break ? EXIT_FAILURE : EXIT_SUCCESS;
     }
+#if defined(BLI_THREADS_INLINE) && defined(WITH_PYTHON)
+    /* Single-threaded WebAssembly, built with JSPI: when `BLENDER_WASM_POLL` holds a Python
+     * statement, Blender stays alive running it, sleeping `BLENDER_WASM_POLL_MS` (default 1)
+     * between runs. The sleep suspends to the JavaScript event loop, which is how a host feeds
+     * this Blender work (its messages are handled during the sleep). The poll runs from here,
+     * not from a Python loop, so only WebAssembly frames are on the stack when it suspends. */
+    if (const char *poll = getenv("BLENDER_WASM_POLL")) {
+      const char *interval_env = getenv("BLENDER_WASM_POLL_MS");
+      const int interval_ms = interval_env ? atoi(interval_env) : 1;
+      for (;;) {
+        BPY_run_string_exec(C, nullptr, poll);
+        emscripten_sleep(interval_ms);
+      }
+    }
+#endif
     /* Using window-manager API in background-mode is a bit odd, but works fine. */
     WM_exit(C, exit_code);
   }
