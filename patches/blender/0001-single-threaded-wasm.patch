diff --git a/source/blender/blenlib/BLI_threads.hh b/source/blender/blenlib/BLI_threads.hh
index 0d711a66..47cbef41 100644
--- a/source/blender/blenlib/BLI_threads.hh
+++ b/source/blender/blenlib/BLI_threads.hh
@@ -10,6 +10,13 @@
 
 #include <pthread.h>
 
+/* Single-threaded WebAssembly (emscripten without `-pthread`): no thread can be started.
+ * Thread pools run each task inline when it is inserted, the system reports one thread, and
+ * the locks below work on the one thread there is. Builds with threads are unaffected. */
+#if defined(__EMSCRIPTEN__) && !defined(__EMSCRIPTEN_PTHREADS__)
+#  define BLI_THREADS_INLINE
+#endif
+
 #include "BLI_listbase.hh"
 #include "BLI_sys_types.hh"
 
diff --git a/source/blender/blenlib/intern/task_pool.cc b/source/blender/blenlib/intern/task_pool.cc
index eaa0307b..1b232102 100644
--- a/source/blender/blenlib/intern/task_pool.cc
+++ b/source/blender/blenlib/intern/task_pool.cc
@@ -189,6 +189,13 @@ struct TaskPool {
     if (this->type == TASK_POOL_BACKGROUND && this->use_threads) {
       this->type = TASK_POOL_TBB;
     }
+#ifdef BLI_THREADS_INLINE
+    /* A background pool's worker waits on its queue for more work, which on the only thread
+     * there is would never return: run its tasks as they are pushed instead. */
+    if (ELEM(this->type, TASK_POOL_BACKGROUND, TASK_POOL_BACKGROUND_SERIAL)) {
+      this->type = TASK_POOL_NO_THREADS;
+    }
+#endif
 
     switch (this->type) {
       case TASK_POOL_TBB:
diff --git a/source/blender/blenlib/intern/threads.cc b/source/blender/blenlib/intern/threads.cc
index 950ca9a8..b4ca2599 100644
--- a/source/blender/blenlib/intern/threads.cc
+++ b/source/blender/blenlib/intern/threads.cc
@@ -186,9 +186,17 @@ void BLI_threadpool_insert(ListBaseT<ThreadSlot> *threadbase, void *callerdata)
 {
   for (ThreadSlot &tslot : *threadbase) {
     if (tslot.avail) {
+#ifdef BLI_THREADS_INLINE
+      /* The task runs to completion here and the slot stays available, so the remove, clear
+       * and end calls below find nothing to join. */
+      tslot.callerdata = callerdata;
+      tslot_thread_start(&tslot);
+      tslot.callerdata = nullptr;
+#else
       tslot.avail = 0;
       tslot.callerdata = callerdata;
       pthread_create(&tslot.pthread, nullptr, tslot_thread_start, &tslot);
+#endif
       return;
     }
   }
@@ -262,6 +270,11 @@ int BLI_system_thread_count()
     return t;
   }
 
+#ifdef BLI_THREADS_INLINE
+  t = 1;
+  return t;
+#endif
+
   {
 #ifdef WIN32
     SYSTEM_INFO info;
