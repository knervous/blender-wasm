diff --git a/intern/ghost/intern/GHOST_ContextWink.cc b/intern/ghost/intern/GHOST_ContextWink.cc
new file mode 100644
index 00000000..2d997395
--- /dev/null
+++ b/intern/ghost/intern/GHOST_ContextWink.cc
@@ -0,0 +1,213 @@
+/* SPDX-FileCopyrightText: 2026 Blender Authors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+/** \file
+ * \ingroup GHOST
+ */
+
+#include "GHOST_ContextWink.hh"
+
+#include <cstdio>
+#include <cstdlib>
+#include <mutex>
+
+#include <wink.h>
+
+/* All contexts share objects through this hidden root, which is never
+ * destroyed: Blender may free its first context (e.g. the initial window's)
+ * while others still live. */
+static wink_context *s_share_root = nullptr;
+static int s_init_status = WINK_ERROR_NOT_INITIALIZED;
+
+static bool wink_ensure_init()
+{
+  static std::once_flag once;
+  std::call_once(once, [] {
+    wink_init_attribs ia;
+    wink_init_attribs_default(&ia);
+    ia.flags = WINK_INIT_GL_ON_MAIN_THREAD;
+    s_init_status = wink_init(&ia);
+    if (s_init_status != WINK_OK) {
+      fprintf(stderr, "GHOST_ContextWink: wink_init failed: %s\n", wink_status_string(s_init_status));
+      return;
+    }
+    int core = 0, compat = 0, es = 0;
+    wink_query_versions(&core, &compat, &es);
+    fprintf(stderr,
+            "GHOST_ContextWink: wink ready (GL core %d.%d, compat %d.%d, ES %d.%d)\n",
+            core / 10,
+            core % 10,
+            compat / 10,
+            compat % 10,
+            es / 10,
+            es % 10);
+
+    wink_context_attribs ca;
+    wink_context_attribs_default(&ca);
+    ca.api = WINK_API_OPENGL_CORE;
+    ca.major = 0; /* Highest available; Blender requires >= 4.3. */
+    ca.minor = 0;
+    int status = WINK_OK;
+    s_share_root = wink_context_create(&ca, &status);
+    if (s_share_root == nullptr) {
+      fprintf(stderr,
+              "GHOST_ContextWink: root context creation failed: %s\n",
+              wink_status_string(status));
+      s_init_status = status;
+    }
+  });
+  return s_init_status == WINK_OK;
+}
+
+GHOST_ContextWink::GHOST_ContextWink(const GHOST_ContextParams &context_params,
+                                     const char *canvas_selector,
+                                     int32_t width,
+                                     int32_t height)
+    : GHOST_Context(context_params),
+      canvas_selector_(canvas_selector),
+      width_(width),
+      height_(height)
+{
+}
+
+GHOST_ContextWink::~GHOST_ContextWink()
+{
+  releaseNativeHandles();
+}
+
+GHOST_TSuccess GHOST_ContextWink::initializeDrawingContext()
+{
+  if (!wink_ensure_init()) {
+    return GHOST_kFailure;
+  }
+
+  if (canvas_selector_) {
+    wink_surface_attribs sa;
+    wink_surface_attribs_default(&sa);
+    sa.canvas = canvas_selector_;
+    sa.width = width_ > 0 ? width_ : 1;
+    sa.height = height_ > 0 ? height_ : 1;
+    /* Blender renders everything into offscreen framebuffers and only blits
+     * into the window's back buffer: no depth/stencil needed there. */
+    sa.alpha_bits = 8;
+    sa.depth_bits = 0;
+    sa.stencil_bits = 0;
+    sa.opaque = 1;
+    sa.manage_canvas_size = 1;
+    int status = WINK_OK;
+    surface_ = wink_surface_create(&sa, &status);
+    if (surface_ == nullptr) {
+      fprintf(stderr,
+              "GHOST_ContextWink: surface creation failed: %s\n",
+              wink_status_string(status));
+      return GHOST_kFailure;
+    }
+  }
+
+  wink_context_attribs ca;
+  wink_context_attribs_default(&ca);
+  ca.api = WINK_API_OPENGL_CORE;
+  ca.major = 0;
+  ca.minor = 0;
+  ca.share = s_share_root;
+  if (context_params_.is_debug) {
+    ca.flags |= WINK_CONTEXT_DEBUG;
+  }
+  int status = WINK_OK;
+  context_ = wink_context_create(&ca, &status);
+  if (context_ == nullptr) {
+    fprintf(
+        stderr, "GHOST_ContextWink: context creation failed: %s\n", wink_status_string(status));
+    releaseNativeHandles();
+    return GHOST_kFailure;
+  }
+
+  activateDrawingContext();
+  return GHOST_kSuccess;
+}
+
+GHOST_TSuccess GHOST_ContextWink::releaseNativeHandles()
+{
+  if (context_ != nullptr) {
+    if (wink_get_current_context() == context_) {
+      wink_make_current(nullptr, nullptr, nullptr);
+    }
+    wink_context_destroy(context_);
+    context_ = nullptr;
+  }
+  if (surface_ != nullptr) {
+    wink_surface_destroy(surface_);
+    surface_ = nullptr;
+  }
+  if (active_context_ == this) {
+    active_context_ = nullptr;
+  }
+  return GHOST_kSuccess;
+}
+
+GHOST_TSuccess GHOST_ContextWink::activateDrawingContext()
+{
+  if (context_ == nullptr) {
+    return GHOST_kFailure;
+  }
+  active_context_ = this;
+  if (wink_get_current_context() == context_ && wink_get_current_surface() == surface_) {
+    return GHOST_kSuccess;
+  }
+  return wink_make_current(context_, surface_, surface_) == WINK_OK ? GHOST_kSuccess :
+                                                                      GHOST_kFailure;
+}
+
+GHOST_TSuccess GHOST_ContextWink::releaseDrawingContext()
+{
+  if (active_context_ == this) {
+    active_context_ = nullptr;
+  }
+  if (context_ != nullptr && wink_get_current_context() == context_) {
+    return wink_make_current(nullptr, nullptr, nullptr) == WINK_OK ? GHOST_kSuccess :
+                                                                     GHOST_kFailure;
+  }
+  return GHOST_kSuccess;
+}
+
+GHOST_TSuccess GHOST_ContextWink::swapBufferRelease()
+{
+  if (surface_ == nullptr) {
+    return GHOST_kFailure;
+  }
+  const bool ok = wink_swap_buffers(surface_) == WINK_OK;
+  if (ok && ++swap_count_ == 2) {
+    /* The page swaps its splash for the canvas on this line (demo/src/main.js);
+     * the first swap is usually the startup clear. */
+    fprintf(stderr, "WINK_FIRST_FRAME %dx%d\n", width_, height_);
+  }
+  return ok ? GHOST_kSuccess : GHOST_kFailure;
+}
+
+GHOST_TSuccess GHOST_ContextWink::setSwapInterval(int interval)
+{
+  if (surface_ == nullptr) {
+    return GHOST_kFailure;
+  }
+  swap_interval_ = interval;
+  return wink_swap_interval(surface_, interval) == WINK_OK ? GHOST_kSuccess : GHOST_kFailure;
+}
+
+GHOST_TSuccess GHOST_ContextWink::getSwapInterval(int &interval_out)
+{
+  interval_out = swap_interval_;
+  return GHOST_kSuccess;
+}
+
+void GHOST_ContextWink::resize(int32_t width, int32_t height)
+{
+  if (width <= 0 || height <= 0 || (width == width_ && height == height_)) {
+    return;
+  }
+  width_ = width;
+  height_ = height;
+  if (surface_ != nullptr) {
+    wink_surface_resize(surface_, width, height);
+  }
+}
diff --git a/intern/ghost/intern/GHOST_ContextWink.hh b/intern/ghost/intern/GHOST_ContextWink.hh
new file mode 100644
index 00000000..711d4a04
--- /dev/null
+++ b/intern/ghost/intern/GHOST_ContextWink.hh
@@ -0,0 +1,62 @@
+/* SPDX-FileCopyrightText: 2026 Blender Authors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+/** \file
+ * \ingroup GHOST
+ * OpenGL context on wink (Mesa's GL on the gex_wgpu WebGPU driver, linked
+ * statically into the wasm module). wink is initialized in its
+ * "GL on the main thread" mode: the WebGPU device, the canvas and the whole
+ * driver live on the browser main thread, and any Blender pthread may make a
+ * context current and call GL; calls are marshalled through Mesa's glthread
+ * and calls that need an answer block the calling worker until main replies.
+ * No JSPI is involved on Blender's side.
+ *
+ * Every context shares objects with the first one created, as GL contexts in
+ * Blender always do (window, offscreen, render and shader-compile contexts).
+ */
+
+#pragma once
+
+#include "GHOST_Context.hh"
+
+#include <cstdint>
+
+struct wink_context;
+struct wink_surface;
+
+class GHOST_ContextWink : public GHOST_Context {
+ public:
+  /**
+   * \param canvas_selector: CSS selector of the canvas to present into, or
+   * nullptr for an offscreen context (no default framebuffer).
+   */
+  GHOST_ContextWink(const GHOST_ContextParams &context_params,
+                    const char *canvas_selector,
+                    int32_t width,
+                    int32_t height);
+  ~GHOST_ContextWink() override;
+
+  GHOST_TSuccess swapBufferAcquire() override
+  {
+    return GHOST_kSuccess;
+  }
+  GHOST_TSuccess swapBufferRelease() override;
+  GHOST_TSuccess activateDrawingContext() override;
+  GHOST_TSuccess releaseDrawingContext() override;
+  GHOST_TSuccess initializeDrawingContext() override;
+  GHOST_TSuccess releaseNativeHandles() override;
+  GHOST_TSuccess setSwapInterval(int interval) override;
+  GHOST_TSuccess getSwapInterval(int &interval_out) override;
+
+  /** Resize the default framebuffer (and the canvas backing store). */
+  void resize(int32_t width, int32_t height);
+
+ private:
+  const char *canvas_selector_;
+  int32_t width_, height_;
+  int swap_interval_ = 1;
+  int swap_count_ = 0;
+  wink_surface *surface_ = nullptr;
+  wink_context *context_ = nullptr;
+};
