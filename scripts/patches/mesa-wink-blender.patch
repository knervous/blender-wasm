+ * kind, and its draw manager keeps the last-vertex convention and draws
+ * through indirect commands, which the rewrite cannot take natively. */
+static uint64_t
+gex_wgpu_vertex_invariant_outputs(nir_shader *nir)
+{
+   uint64_t written = 0, variant = 0;
+   nir_function_impl *impl = nir_shader_get_entrypoint(nir);
+   if (!impl)
+      return 0;
+   struct hash_table *memo = _mesa_pointer_hash_table_create(NULL);
