+      break;
+   case nir_instr_type_alu: {
+      nir_alu_instr *alu = nir_instr_as_alu(instr);
+      inv = true;
+      for (unsigned i = 0; inv && i < nir_op_infos[alu->op].num_inputs; ++i)
+         inv = gex_wgpu_def_vertex_invariant(alu->src[i].src.ssa, memo, depth + 1);
+      break;
+   }
+   case nir_instr_type_tex: {
