+         nir_variable *var = dst ? nir_deref_instr_get_variable(dst) : NULL;
+         if (!var || var->data.mode != nir_var_shader_out ||
+             var->data.location < 0 ||
+             var->data.location >= GEX_WGPU_MAX_VARYING_LOCATIONS)
