+/**
+ * glFenceSync for a remote glthread context's application thread
+ * (glthread_remote.c): the object, made and published here so the handle can
+ * be returned at once. Its fence is attached on the driver thread by
+ * _mesa_fence_sync_object, queued ahead of anything that can wait on it.
+ */
+struct gl_sync_object *
+_mesa_new_unfenced_sync(struct gl_context *ctx, GLenum condition, GLbitfield flags)
+{
+   struct gl_sync_object *syncObj = new_sync_object(ctx);
+   if (!syncObj)
+      return NULL;
+   syncObj->Name = 1;
+   syncObj->RefCount = 1;
+   syncObj->DeletePending = GL_FALSE;
+   syncObj->SyncCondition = condition;
+   syncObj->Flags = flags;
+   syncObj->StatusFlag = 0;
+   simple_mtx_lock(&ctx->Shared->Mutex);
+   _mesa_set_add(ctx->Shared->SyncObjects, syncObj);
+   simple_mtx_unlock(&ctx->Shared->Mutex);
+   return syncObj;
+}
+
+void
+_mesa_fence_sync_object(struct gl_context *ctx, struct gl_sync_object *syncObj)
+{
+   simple_mtx_lock(&syncObj->mutex);
+   ctx->pipe->flush(ctx->pipe, &syncObj->fence, 0);
+   simple_mtx_unlock(&syncObj->mutex);
+}
+
+
 GLsync GLAPIENTRY
 _mesa_FenceSync_no_error(GLenum condition, GLbitfield flags)
 {
