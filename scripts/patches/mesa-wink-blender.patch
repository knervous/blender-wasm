diff --git a/src/mesa/main/glthread_remote.c b/src/mesa/main/glthread_remote.c
new file mode 100644
index 0000000..6607cf3
--- /dev/null
+++ b/src/mesa/main/glthread_remote.c
@@ -0,0 +1,500 @@
+/*
+ * Copyright © 2026
+ * SPDX-License-Identifier: MIT
+ */
+
+/* MESA_GLTHREAD_REMOTE: calls a remote context takes on the application
+ * thread without a round trip to its driver thread.
+ *
+ * A remote context's driver runs on the browser main thread; a call that
+ * needs an answer waits for that thread to get to it, behind everything
+ * queued before. Each of these is something an application does many times
+ * a frame -- Blender's immediate mode maps a buffer for every widget, and it
+ * creates a texture for every icon -- and each can be answered here:
+ *
+ *  - glGenTextures / glGenBuffers: names come from the share group's tables,
+ *    under their mutexes, with the same empty objects the driver would make
+ *    (pure CPU state, which st/mesa creates without the driver).
+ *  - glGenVertexArrays: a context's own table belongs to its driver thread,
+ *    so names come from a range this thread hands out (from 2^30, which a
+ *    table allocating its lowest free name does not reach), and the objects
+ *    are made there by a queued call, ahead of anything that uses them.
+ *  - Write-only glMapBufferRange that does not need the old contents
+ *    (invalidating, explicitly flushed or unsynchronized): the application
+ *    writes into memory here, and the flushed ranges -- or, unflushed, the
+ *    whole range -- go to the buffer as glBufferSubData at flush or unmap,
+ *    through glthread's own upload path, in order with everything else.
+ *  - glClear*BufferData / glClear*BufferSubData: the clear value (one texel,
+ *    at most 16 bytes) is copied and the call queued.
+ *  - glFenceSync: the sync object is made here, under the share group's
+ *    mutex, and its fence attached by a queued call on the driver thread.
+ *  - glGetTexLevelParameteriv of a proxy target's width, height or depth:
+ *    answered from the last proxy glTexImage*D against the context's limits,
+ *    which is what a proxy query is for (Blender asks for every texture it
+ *    creates).
+ *
+ * WINK_GLTHREAD_REMOTE_FAST=0 turns all of it off, for comparison.
+ */
+
+#include "main/glthread.h"
+#include "main/glthread_marshal.h"
+#include "main/arrayobj.h"
+#include "main/bufferobj.h"
+#include "main/hash.h"
+#include "main/glformats.h"
+#include "main/image.h"
+#include "main/mtypes.h"
+#include "main/syncobj.h"
+#include "main/teximage.h"
+#include "main/texobj.h"
+#include "dispatch.h"
+#include "util/u_debug.h"
+
+#if MESA_GLTHREAD_REMOTE
+
+static bool
+remote_fast(void)
+{
+   static int on = -1;
+   if (on < 0)
+      on = debug_get_bool_option("WINK_GLTHREAD_REMOTE_FAST", true);
+   return on;
+}
+
+/* ---------------------------------------------------------------------- */
+/* Names */
+
+bool
+_mesa_glthread_remote_GenTextures(struct gl_context *ctx, GLsizei n,
+                                  GLuint *textures)
+{
+   if (!remote_fast() || n < 0 || !textures)
+      return false;
+   struct _mesa_HashTable *table = &ctx->Shared->TexObjects;
+   _mesa_HashLockMutex(table);
+   _mesa_HashFindFreeKeys(table, textures, n);
+   for (GLsizei i = 0; i < n; i++) {
+      struct gl_texture_object *obj = _mesa_new_texture_object(ctx, textures[i], 0);
+      if (!obj) {
+         /* Hand what is left to the driver, which reports the error. */
+         _mesa_HashUnlockMutex(table);
+         return false;
+      }
+      _mesa_HashInsertLocked(table, textures[i], obj);
+   }
+   _mesa_HashUnlockMutex(table);
+   return true;
+}
+
+bool
+_mesa_glthread_remote_GenBuffers(struct gl_context *ctx, GLsizei n,
+                                 GLuint *buffers)
+{
+   if (!remote_fast() || n < 0 || !buffers)
+      return false;
+   _mesa_reserve_buffer_names(ctx, n, buffers);
+   return true;
+}
+
+struct remote_vaos {
+   GLsizei n;
+   GLuint names[];
+};
+
+static void
+remote_vaos_run(struct gl_context *ctx, void *data)
+{
+   struct remote_vaos *v = data;
+   for (GLsizei i = 0; i < v->n; i++) {
+      struct gl_vertex_array_object *obj = _mesa_new_vao(ctx, v->names[i]);
+      if (!obj) {
+         _mesa_error(ctx, GL_OUT_OF_MEMORY, "glGenVertexArrays");
+         break;
+      }
+      _mesa_HashInsertLocked(&ctx->Array.Objects, obj->Name, obj);
+   }
+   free(v);
+}
+
+bool
+_mesa_glthread_remote_GenVertexArrays(struct gl_context *ctx, GLsizei n,
+                                      GLuint *arrays)
+{
+   if (!remote_fast() || n < 0 || !arrays)
+      return false;
+   struct glthread_state *glthread = &ctx->GLThread;
+   if (glthread->remote_next_vao < (1u << 30))
+      glthread->remote_next_vao = 1u << 30;
+   struct remote_vaos *v = malloc(sizeof(*v) + n * sizeof(GLuint));
+   if (!v)
+      return false;
+   v->n = n;
+   for (GLsizei i = 0; i < n; i++)
+      v->names[i] = arrays[i] = glthread->remote_next_vao++;
+   _mesa_glthread_call_async(ctx, remote_vaos_run, v, NULL);
+   _mesa_glthread_GenVertexArrays(ctx, n, arrays);
+   return true;
+}
+
+/* ---------------------------------------------------------------------- */
+/* Write-only maps */
+
+static struct glthread_remote_map *
+remote_map_find(struct gl_context *ctx, GLenum target, GLuint buffer)
+{
+   struct glthread_state *glthread = &ctx->GLThread;
+   for (unsigned i = 0; i < ARRAY_SIZE(glthread->remote_maps); i++) {
+      struct glthread_remote_map *m = &glthread->remote_maps[i];
+      if (m->data && m->target == target && m->buffer == buffer)
+         return m;
+   }
+   return NULL;
+}
+
+static bool
+remote_map(struct gl_context *ctx, GLenum target, GLuint buffer,
+           GLintptr offset, GLsizeiptr length, GLbitfield access, GLvoid **ret)
+{
+   if (!remote_fast())
+      return false;
+   /* Only maps that never show the application the buffer's contents. */
+   if (!(access & GL_MAP_WRITE_BIT) ||
+       (access & (GL_MAP_READ_BIT | GL_MAP_PERSISTENT_BIT | GL_MAP_COHERENT_BIT)) ||
+       !(access & (GL_MAP_INVALIDATE_RANGE_BIT | GL_MAP_INVALIDATE_BUFFER_BIT |
+                   GL_MAP_FLUSH_EXPLICIT_BIT | GL_MAP_UNSYNCHRONIZED_BIT)))
+      return false;
+   if (offset < 0 || length <= 0 || length > (64 << 20))
+      return false;
+   if (remote_map_find(ctx, target, buffer))
+      return false; /* already mapped: the driver reports the error */
+   struct glthread_state *glthread = &ctx->GLThread;
+   for (unsigned i = 0; i < ARRAY_SIZE(glthread->remote_maps); i++) {
+      struct glthread_remote_map *m = &glthread->remote_maps[i];
+      if (m->data)
+         continue;
+      m->data = malloc(length);
+      if (!m->data)
+         return false;
+      m->target = target;
+      m->buffer = buffer;
+      m->offset = offset;
+      m->length = length;
+      m->access = access;
+      *ret = m->data;
+      return true;
+   }
+   return false;
+}
+
+/* Upload [off, off+len) of the map through glthread's marshalled upload,
+ * which copies it into the batch (or alongside, when big). */
+static void
+remote_map_upload(struct gl_context *ctx, struct glthread_remote_map *m,
+                  GLintptr off, GLsizeiptr len)
+{
+   if (off < 0 || len <= 0 || off + len > m->length)
+      return;
+   if (m->buffer)
+      CALL_NamedBufferSubData(ctx->MarshalExec,
+                              (m->buffer, m->offset + off, len, m->data + off));
+   else
+      CALL_BufferSubData(ctx->MarshalExec,
+                         (m->target, m->offset + off, len, m->data + off));
+}
+
+static bool
+remote_flush(struct gl_context *ctx, GLenum target, GLuint buffer,
+             GLintptr offset, GLsizeiptr length)
+{
+   struct glthread_remote_map *m = remote_map_find(ctx, target, buffer);
+   if (!m)
+      return false;
+   if (m->access & GL_MAP_FLUSH_EXPLICIT_BIT)
+      remote_map_upload(ctx, m, offset, length);
+   return true;
+}
+
+static bool
+remote_unmap(struct gl_context *ctx, GLenum target, GLuint buffer, GLboolean *ret)
+{
+   struct glthread_remote_map *m = remote_map_find(ctx, target, buffer);
+   if (!m)
+      return false;
+   if (!(m->access & GL_MAP_FLUSH_EXPLICIT_BIT))
+      remote_map_upload(ctx, m, 0, m->length);
+   free(m->data);
+   m->data = NULL;
+   *ret = GL_TRUE;
+   return true;
+}
+
+bool
+_mesa_glthread_remote_MapBufferRange(struct gl_context *ctx, GLenum target,
+                                     GLintptr offset, GLsizeiptr length,
+                                     GLbitfield access, GLvoid **ret)
+{
+   return remote_map(ctx, target, 0, offset, length, access, ret);
+}
+
+bool
+_mesa_glthread_remote_MapNamedBufferRange(struct gl_context *ctx, GLuint buffer,
+                                          GLintptr offset, GLsizeiptr length,
+                                          GLbitfield access, GLvoid **ret)
+{
+   return buffer && remote_map(ctx, 0, buffer, offset, length, access, ret);
+}
+
+bool
+_mesa_glthread_remote_FlushMappedBufferRange(struct gl_context *ctx,
+                                             GLenum target, GLintptr offset,
+                                             GLsizeiptr length)
+{
+   return remote_flush(ctx, target, 0, offset, length);
+}
+
+bool
+_mesa_glthread_remote_FlushMappedNamedBufferRange(struct gl_context *ctx,
+                                                  GLuint buffer, GLintptr offset,
+                                                  GLsizeiptr length)
+{
+   return buffer && remote_flush(ctx, 0, buffer, offset, length);
+}
+
+bool
+_mesa_glthread_remote_UnmapBuffer(struct gl_context *ctx, GLenum target,
+                                  GLboolean *ret)
+{
+   return remote_unmap(ctx, target, 0, ret);
+}
+
+bool
+_mesa_glthread_remote_UnmapNamedBufferEXT(struct gl_context *ctx, GLuint buffer,
+                                          GLboolean *ret)
+{
+   return buffer && remote_unmap(ctx, 0, buffer, ret);
+}
+
+/* ---------------------------------------------------------------------- */
+/* Buffer clears */
+
+struct remote_clear {
+   GLenum target;
+   GLuint buffer;
+   GLenum internalformat, format, type;
+   GLintptr offset;
+   GLsizeiptr size;
+   bool sub, has_data;
+   uint8_t data[16];
+};
+
+static void
+remote_clear_run(struct gl_context *ctx, void *p)
+{
+   struct remote_clear *c = p;
+   const void *data = c->has_data ? c->data : NULL;
+   if (c->buffer && c->sub)
+      CALL_ClearNamedBufferSubData(ctx->Dispatch.Current,
+                                   (c->buffer, c->internalformat, c->offset,
+                                    c->size, c->format, c->type, data));
+   else if (c->buffer)
+      CALL_ClearNamedBufferData(ctx->Dispatch.Current,
+                                (c->buffer, c->internalformat, c->format,
+                                 c->type, data));
+   else if (c->sub)
+      CALL_ClearBufferSubData(ctx->Dispatch.Current,
+                              (c->target, c->internalformat, c->offset,
+                               c->size, c->format, c->type, data));
+   else
+      CALL_ClearBufferData(ctx->Dispatch.Current,
+                           (c->target, c->internalformat, c->format, c->type,
+                            data));
+   free(c);
+}
+
+static bool
+remote_clear(struct gl_context *ctx, struct remote_clear *args, const GLvoid *data)
+{
+   if (!remote_fast())
+      return false;
+   if (data) {
+      const GLint bpp = _mesa_bytes_per_pixel(args->format, args->type);
+      if (bpp <= 0 || bpp > 16)
+         return false;
+      memcpy(args->data, data, bpp);
+      args->has_data = true;
+   }
+   struct remote_clear *c = malloc(sizeof(*c));
+   if (!c)
+      return false;
+   *c = *args;
+   _mesa_glthread_call_async(ctx, remote_clear_run, c, NULL);
+   return true;
+}
+
+bool
+_mesa_glthread_remote_ClearBufferData(struct gl_context *ctx, GLenum target,
+                                      GLenum internalformat, GLenum format,
+                                      GLenum type, const GLvoid *data)
+{
+   struct remote_clear c = { .target = target, .internalformat = internalformat,
+                             .format = format, .type = type };
+   return remote_clear(ctx, &c, data);
+}
+
+bool
+_mesa_glthread_remote_ClearNamedBufferData(struct gl_context *ctx, GLuint buffer,
+                                           GLenum internalformat, GLenum format,
+                                           GLenum type, const GLvoid *data)
+{
+   struct remote_clear c = { .buffer = buffer, .internalformat = internalformat,
+                             .format = format, .type = type };
+   return buffer && remote_clear(ctx, &c, data);
+}
+
+bool
+_mesa_glthread_remote_ClearBufferSubData(struct gl_context *ctx, GLenum target,
+                                         GLenum internalformat, GLintptr offset,
+                                         GLsizeiptr size, GLenum format,
+                                         GLenum type, const GLvoid *data)
+{
+   struct remote_clear c = { .target = target, .internalformat = internalformat,
+                             .format = format, .type = type, .offset = offset,
+                             .size = size, .sub = true };
+   return remote_clear(ctx, &c, data);
+}
+
+bool
+_mesa_glthread_remote_ClearNamedBufferSubData(struct gl_context *ctx,
+                                              GLuint buffer,
+                                              GLenum internalformat,
+                                              GLintptr offset, GLsizeiptr size,
+                                              GLenum format, GLenum type,
+                                              const GLvoid *data)
+{
+   struct remote_clear c = { .buffer = buffer, .internalformat = internalformat,
+                             .format = format, .type = type, .offset = offset,
+                             .size = size, .sub = true };
+   return buffer && remote_clear(ctx, &c, data);
+}
+
+/* ---------------------------------------------------------------------- */
+/* Fences */
+
+static void
+remote_fence_run(struct gl_context *ctx, void *data)
+{
+   _mesa_fence_sync_object(ctx, data);
+}
+
+bool
+_mesa_glthread_remote_FenceSync(struct gl_context *ctx, GLenum condition,
+                                GLbitfield flags, GLsync *ret)
+{
+   if (!remote_fast() || condition != GL_SYNC_GPU_COMMANDS_COMPLETE || flags)
+      return false;
+   struct gl_sync_object *so = _mesa_new_unfenced_sync(ctx, condition, flags);
+   if (!so)
+      return false;
+   _mesa_glthread_call_async(ctx, remote_fence_run, so, NULL);
+   *ret = (GLsync)so;
+   return true;
+}
+
+/* ---------------------------------------------------------------------- */
+/* Proxy textures */
+
+void
+_mesa_glthread_remote_note_proxy(struct gl_context *ctx, GLenum target,
+                                 GLint level, GLsizei width, GLsizei height,
+                                 GLsizei depth)
+{
+   ctx->GLThread.remote_proxy.target = target;
+   ctx->GLThread.remote_proxy.level = level;
+   ctx->GLThread.remote_proxy.width = width;
+   ctx->GLThread.remote_proxy.height = height;
+   ctx->GLThread.remote_proxy.depth = depth;
+}
+
+bool
+_mesa_glthread_remote_TexImage1D(struct gl_context *ctx, GLenum target,
+                                 GLint level, GLint internalformat,
+                                 GLsizei width, GLint border, GLenum format,
+                                 GLenum type, const GLvoid *pixels)
+{
+   if (_mesa_is_proxy_texture(target))
+      _mesa_glthread_remote_note_proxy(ctx, target, level, width, 1, 1);
+   return false;
+}
+
+bool
+_mesa_glthread_remote_TexImage3D(struct gl_context *ctx, GLenum target,
+                                 GLint level, GLint internalformat,
+                                 GLsizei width, GLsizei height, GLsizei depth,
+                                 GLint border, GLenum format, GLenum type,
+                                 const GLvoid *pixels)
+{
+   if (_mesa_is_proxy_texture(target))
+      _mesa_glthread_remote_note_proxy(ctx, target, level, width, height, depth);
+   return false;
+}
+
+static bool
+remote_proxy_fits(struct gl_context *ctx, GLenum target, GLint level,
+                  GLsizei w, GLsizei h, GLsizei d)
+{
+   const struct gl_constants *c = &ctx->Const;
+   if (level < 0 || w <= 0 || h <= 0 || d <= 0)
+      return false;
+   GLint max;
+   switch (target) {
+   case GL_PROXY_TEXTURE_3D:
+      max = 1 << (c->Max3DTextureLevels - 1);
+      return level < c->Max3DTextureLevels && w <= max && h <= max && d <= max;
+   case GL_PROXY_TEXTURE_CUBE_MAP:
+      max = 1 << (c->MaxCubeTextureLevels - 1);
+      return level < c->MaxCubeTextureLevels && w <= max && h <= max && w == h;
+   case GL_PROXY_TEXTURE_CUBE_MAP_ARRAY:
+      max = 1 << (c->MaxCubeTextureLevels - 1);
+      return level < c->MaxCubeTextureLevels && w <= max && h <= max && w == h &&
+             d <= (GLsizei)c->MaxArrayTextureLayers;
+   case GL_PROXY_TEXTURE_RECTANGLE:
+      return level == 0 && w <= (GLsizei)c->MaxTextureRectSize &&
+             h <= (GLsizei)c->MaxTextureRectSize;
+   case GL_PROXY_TEXTURE_1D_ARRAY:
+      return level < _mesa_max_texture_levels(ctx, target) &&
+             w <= (GLsizei)c->MaxTextureSize && h <= (GLsizei)c->MaxArrayTextureLayers;
+   case GL_PROXY_TEXTURE_2D_ARRAY:
+      return level < _mesa_max_texture_levels(ctx, target) &&
+             w <= (GLsizei)c->MaxTextureSize && h <= (GLsizei)c->MaxTextureSize &&
+             d <= (GLsizei)c->MaxArrayTextureLayers;
+   case GL_PROXY_TEXTURE_1D:
+   case GL_PROXY_TEXTURE_2D:
+      return level < _mesa_max_texture_levels(ctx, target) &&
+             w <= (GLsizei)c->MaxTextureSize && h <= (GLsizei)c->MaxTextureSize;
+   default:
+      return false;
+   }
+}
+
+bool
+_mesa_glthread_remote_GetTexLevelParameteriv(struct gl_context *ctx,
+                                             GLenum target, GLint level,
+                                             GLenum pname, GLint *params)
+{
+   const __typeof__(ctx->GLThread.remote_proxy) *p = &ctx->GLThread.remote_proxy;
+   if (!remote_fast() || !params || !_mesa_is_proxy_texture(target) ||
+       p->target != target || p->level != level)
+      return false;
+   if (pname != GL_TEXTURE_WIDTH && pname != GL_TEXTURE_HEIGHT &&
+       pname != GL_TEXTURE_DEPTH)
+      return false;
+   if (!remote_proxy_fits(ctx, target, level, p->width, p->height, p->depth)) {
+      *params = 0;
+      return true;
+   }
+   *params = pname == GL_TEXTURE_WIDTH ? p->width
+           : pname == GL_TEXTURE_HEIGHT ? p->height : p->depth;
+   return true;
+}
+
+#endif /* MESA_GLTHREAD_REMOTE */
